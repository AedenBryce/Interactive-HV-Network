{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"]
  },
  "files": ["src/main.tsx", "src/ui/continuous-network.worker.ts", "src/ui/authored-schematic.ts", "src/ui/authored-layout-loader.ts", "vite.config.ts"],
  "include": []
}
